{
  "name": "Meshy 3D Generation API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meshy-generate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "generate-webhook",
      "name": "Generate Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 0],
      "webhookId": "meshy-generate"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.meshy.ai/v2/text-to-3d",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"mode\": \"preview\",\n  \"prompt\": \"{{ $json.body.prompt }}\",\n  \"art_style\": \"{{ $json.body.artStyle || 'realistic' }}\",\n  \"negative_prompt\": \"low quality, blurry, distorted, deformed\"\n}",
        "options": {}
      },
      "id": "meshy-api-call",
      "name": "Meshy Text-to-3D API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "meshy-api-key",
          "name": "Meshy API Key"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, taskId: $json.result, result: $json }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type"
              }
            ]
          }
        }
      },
      "id": "respond-generate",
      "name": "Respond Generate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [300, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.message || 'Error calling Meshy API' }) }}",
        "options": {
          "responseCode": 500,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [300, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meshy-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "status-webhook",
      "name": "Status Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 400],
      "webhookId": "meshy-status"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.meshy.ai/v2/text-to-3d/{{ $json.body.taskId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "id": "meshy-status-call",
      "name": "Check Task Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "meshy-api-key",
          "name": "Meshy API Key"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, status: $json.status, progress: $json.progress, modelUrls: $json.model_urls, thumbnailUrl: $json.thumbnail_url, result: $json }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type"
              }
            ]
          }
        }
      },
      "id": "respond-status",
      "name": "Respond Status",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [300, 400]
    }
  ],
  "connections": {
    "Generate Webhook": {
      "main": [[{ "node": "Meshy Text-to-3D API", "type": "main", "index": 0 }]]
    },
    "Meshy Text-to-3D API": {
      "main": [[{ "node": "Respond Generate", "type": "main", "index": 0 }]]
    },
    "Status Webhook": {
      "main": [[{ "node": "Check Task Status", "type": "main", "index": 0 }]]
    },
    "Check Task Status": {
      "main": [[{ "node": "Respond Status", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 2,
  "versionId": "meshy-generate-v1"
}
